generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//user model 
model User {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  personalNumber String          @unique
  password       String
  employeeRole   UserRole
  teamLeaderName String
  userDepartment ValidDepartment
  firstName      String
  lastName       String

  //optional fields
  displayName String?
  avatar      String?
  schedule    SchedulePlan[]

  //relations for user
  Society      Society?    @relation(fields: [societyId], references: [id])
  societyId    String?     @db.ObjectId
  Department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?     @db.ObjectId

  @@map("users")
}

//Society, e.g Donauversicherung
model Society {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  societyName        String
  societyGroup       String
  societyDepartments Department[]
  allSocietyUsers    User[]
  numOfDepartments   Int
  allUsers           AllUsers

  @@map("societies")
}

//One of many department in a society, e.g IT Department
model Department {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  departmentName     ValidDepartment @unique
  allDepartmentUsers User[] //TODO: FILTER specifically for the users in that department
  allUsers           AllUsers

  //a department is related to a society 
  Society   Society? @relation(fields: [societyId], references: [id])
  societyId String?  @db.ObjectId

  @@map("departments")
}

//model for user schedule plan
model SchedulePlan {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  year         DateTime
  month        DateTime
  weekSchedule DaySchedule[]
  user         User?         @relation(fields: [userId], references: [id])
  userId       String?       @db.ObjectId

  @@map("schedules")
}

//subtype schedule plan day 
type DaySchedule {
  weekday          DateTime
  startShift       DateTime
  endShift         DateTime
  employeeIsAbsent Boolean       @default(false)
  absentReason     CheckIfDayOff @default(WORKING)
}

//keep track of user count
type AllUsers {
  admins      Int
  normalUsers Int
  totalUsers  Int
}

//enum types 
enum UserRole {
  USER
  ADMIN
}

enum CheckIfDayOff {
  URLAUB
  KRANKENSTAND
  WORKING
}

//add more departments here if needed
enum ValidDepartment {
  IT
  VK
  HR
}

